# ============================================================================
# Copy to .env and fill in. Every variable the system reads is listed here.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Postgres (app data + LangGraph checkpoints) ----------------------------
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bank

# --- LLM ---------------------------------------------------------------------
# Local (default, no API key): install Ollama on the host, then `ollama pull llama3.1:8b`.
# docker-compose points the containers at the host's Ollama automatically.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434   # only when running outside Docker
# Hosted alternative: LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5-5, plus the key below.
ANTHROPIC_API_KEY=

# --- MCP mode ----------------------------------------------------------------
# true  = demo: Gmail/Calendar/Slack MCP servers store emails, events and messages locally
#         (view them in the "Mock outbox" tab). No Google/Slack accounts or OAuth needed.
# false = real Gmail/Calendar/Slack via each user's OAuth connection (fill the sections below).
MCP_MOCK=false  # true = local simulation for development only (never for a submission or demo)

# --- Secrets -----------------------------------------------------------------
# Signs user session JWTs issued by the API.
JWT_SECRET=change-me-long-random
# Master key for OAuth token encryption. A per-(user, service) Fernet key is
# derived from it with HKDF, so a blob stored for user A cannot be decrypted
# as user B. Rotating it invalidates all stored connections.
TOKEN_ENCRYPTION_KEY=change-me-long-random
# Signs the short-lived (60 s) per-user tokens the API sends to the MCP servers.
MCP_INTERNAL_SECRET=change-me-long-random

# --- URLs --------------------------------------------------------------------
# Browser-reachable URL of the API (used to build OAuth redirect URIs).
PUBLIC_API_URL=http://localhost:8000
# Browser-reachable URL of the Streamlit app.
FRONTEND_URL=http://localhost:8501

# --- Google OAuth2 (Gmail + Calendar) ---------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Enable the Gmail API and Google Calendar API. Add the redirect URI below.
# PREFERRED: leave these two empty and paste the client in the app (officer account > Integrations setup).
# It is then stored encrypted in the database, not in this file. Values here are only a fallback for automated deploys.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register BOTH redirect URIs on the same OAuth client (the MCP servers host the OAuth endpoints):
#   http://localhost:8101/oauth/callback   (Gmail)
#   http://localhost:8102/oauth/callback   (Calendar)
MCP_PUBLIC_GMAIL=http://localhost:8101
MCP_PUBLIC_CALENDAR=http://localhost:8102

# --- Slack OAuth2 -------------------------------------------------------------
# api.slack.com/apps -> OAuth & Permissions. Bot scopes: chat:write,
# chat:write.public, channels:read, users:read, users:read.email.
# Slack requires an HTTPS redirect URL: tunnel the Slack MCP server (port 8103), e.g. `ngrok http 8103`.
# Same as Google: preferably entered in the app (Integrations setup) instead of here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Tunnel to the SLACK MCP SERVER:  ngrok http 8103   ->   https://<tunnel>/oauth/callback
SLACK_REDIRECT_URI=https://your-tunnel.example.com/oauth/callback
MCP_PUBLIC_SLACK=http://localhost:8103

# --- Banking behaviour -------------------------------------------------------
# Comma-separated emails that get the "officer" role at registration
# (can upload bank-wide files and decide human-in-the-loop approvals).
OFFICER_EMAILS=officer@example.com
# Fallback when the compliance CSV has no matching threshold.
LARGE_TRANSFER_THRESHOLD=10000
DEFAULT_TIMEZONE=Asia/Kolkata
BRANCH_ADDRESS=Main Branch, 1 Banking Plaza, Mumbai 400001
BANK_NAME=Demo Retail Bank
# Used by the "Load demo data" button to fill the demo customer profile.
DEMO_RM_NAME=Priya Sharma
DEMO_RM_EMAIL=rm@example.com

# --- Limits / storage --------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_TABLE_ROWS=100000
# Overridden by docker-compose; only needed when running outside Docker.
# DATABASE_URL=postgresql+asyncpg://bank:change-me-postgres@localhost:5432/bank
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# UPLOAD_DIR=./data/uploads
# MCP_GMAIL_URL=http://localhost:8101/mcp
# MCP_CALENDAR_URL=http://localhost:8102/mcp
# MCP_SLACK_URL=http://localhost:8103/mcp
